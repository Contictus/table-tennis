{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Table Tennis Multiplayer Protocol",
  "definitions": {
    "Envelope": {
      "type": "object",
      "required": ["v", "type", "payload"],
      "properties": {
        "v": { "const": 1 },
        "type": { "type": "string" },
        "payload": { "type": "object" }
      },
      "additionalProperties": false
    },
    "PaddleTarget": {
      "type": "object",
      "required": ["x", "z"],
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "z": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "ClientMessage": {
      "oneOf": [
        {
          "type": "object",
          "required": ["v", "type", "payload"],
          "properties": {
            "v": { "const": 1 },
            "type": { "const": "hello" },
            "payload": {
              "type": "object",
              "required": ["roomCode", "sessionToken"],
              "properties": {
                "roomCode": { "type": "string", "minLength": 5, "maxLength": 5 },
                "sessionToken": { "type": "string", "minLength": 16 }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["v", "type", "payload"],
          "properties": {
            "v": { "const": 1 },
            "type": { "const": "player_ready" },
            "payload": {
              "type": "object",
              "required": ["ready"],
              "properties": { "ready": { "type": "boolean" } },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["v", "type", "payload"],
          "properties": {
            "v": { "const": 1 },
            "type": { "const": "paddle_move" },
            "payload": {
              "type": "object",
              "required": ["seq", "target"],
              "properties": {
                "seq": { "type": "integer", "minimum": 0 },
                "target": { "$ref": "#/definitions/PaddleTarget" }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "ServerMessage": {
      "type": "object",
      "required": ["v", "type", "payload"],
      "properties": {
        "v": { "const": 1 },
        "type": {
          "enum": [
            "room_state",
            "match_started",
            "match_state",
            "point_ended",
            "match_ended",
            "player_disconnected",
            "player_reconnected",
            "error"
          ]
        },
        "payload": { "type": "object" }
      },
      "additionalProperties": false
    }
  }
}
